# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.ts]
indent_style = tab

[{package.json, tsconfig.json, biome.json, .eslintrc.json}]
indent_style = space
indent_size = 2